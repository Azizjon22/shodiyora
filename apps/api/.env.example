DATABASE_URL="postgresql://shodiyora:shodiyora@localhost:5436/shodiyora?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Empty S3 settings store photos and videos in apps/api/uploads.
# Fill these for MinIO or Cloudflare R2 later; the upload API stays the same.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
