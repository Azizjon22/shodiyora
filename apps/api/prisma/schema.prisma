generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  ZAVZAL
}

enum WorkerPosition {
  WAITER_MALE
  WAITER_FEMALE
  CHEF
  OTHER
}

enum WorkerGender {
  MALE
  FEMALE
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MenuPackageType {
  FULL
  FOOD_ONLY
}

enum MenuDishCategory {
  SALAD
  FIRST_DISH
  SECOND_DISH
  FRUIT
  DESSERT
  DRINK
  OTHER
}

enum MenuMediaSection {
  HALL
  TABLE_SETUP
  FOOD
  KORTEJ
  ARTIST
  PHOTOGRAPHER
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
}

// A freshly uploaded HEVC (.mov) video is unplayable in most browsers —
// PROCESSING covers the window where it's being transcoded to H.264 in
// the background; READY is the only state the public showcase ever plays.
enum MediaProcessingStatus {
  READY
  PROCESSING
  FAILED
}

enum Unit {
  KG
  LITER
  DONA
}

enum InventoryCategory {
  DISHWARE
  PRODUCT
}

enum ProductCategory {
  VEGETABLE
  FRUIT
  MEAT
  DAIRY
  GREENS
  GRAIN
  OIL
  SPICE
  DRINK
  OTHER
}

enum InventoryTxnType {
  IN
  OUT
}

enum ShoppingListStatus {
  SUBMITTED
  REVIEWED
  APPROVED
  PURCHASED
  CLOSED
}

enum EventExpenseCategory {
  SHOPPING
  STOCK
  CAMERAMAN
  ARTIST
  KORTEJ
  CHEF
  WAITERS
  ZAVZAL
  CARWASH
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

// ---------- Staff (admin panel users) ----------

model StaffUser {
  id                 String    @id @default(cuid())
  fullName           String
  phone              String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  role               StaffRole
  isActive           Boolean   @default(true)
  // Telegram chat linked through the bot (phone + password); notifications go here.
  telegramChatId     String?   @unique
  tokenVersion       Int       @default(0)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdEvents         Event[]                 @relation("EventCreatedBy")
  assignmentsMade       EventWorkerAssignment[] @relation("AssignmentByStaff")
  approvedWorkers       Worker[]                @relation("WorkerApprovedBy")
  inventoryTransactions InventoryTransaction[]
  reviewedShoppingLists ShoppingList[]          @relation("ShoppingListReviewedBy")
  approvedShoppingLists ShoppingList[]          @relation("ShoppingListApprovedBy")
  payments              Payment[]
  expenses              EventExpense[]

  @@map("staff_users")
}

// ---------- Workers (hall staff: waiters / chefs) ----------

model Worker {
  id               String         @id @default(cuid())
  fullName         String
  phone            String         @unique
  pinHash          String?
  mustChangePin    Boolean        @default(false)
  photoUrl         String?
  position         WorkerPosition
  gender           WorkerGender?
  status           WorkerStatus   @default(PENDING)
  // Telegram chat linked through the bot (phone + PIN); reminders go here.
  telegramChatId   String?        @unique
  approvedBy       StaffUser?     @relation("WorkerApprovedBy", fields: [approvedById], references: [id])
  approvedById     String?
  tokenVersion     Int            @default(0)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignments   EventWorkerAssignment[]
  shoppingLists ShoppingList[]
  stockUsages   StockUsage[]

  @@map("workers")
}

// ---------- Menu packages ----------

model Menu {
  id            String          @id @default(cuid())
  name          String
  // Flat price for the whole package at `guestCount` guests — not a
  // per-person rate. A booked event's totalPrice is copied from this at
  // creation time and never recalculated off guest count (see
  // EventsService.create/update).
  price         Decimal         @db.Decimal(14, 2)
  guestCount    Int             @default(100)
  packageType   MenuPackageType @default(FOOD_ONLY)
  description   String?
  coverImageUrl String?
  isVip         Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  dishes MenuDish[]
  media  MenuMedia[]
  events Event[]

  @@map("menus")
}

model MenuDish {
  id          String           @id @default(cuid())
  menuId      String
  menu        Menu             @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category    MenuDishCategory
  name        String
  description String?
  photoUrl    String?
  order       Int              @default(0)

  @@index([menuId])
  @@map("menu_dishes")
}

model MenuMedia {
  id               String                @id @default(cuid())
  menuId           String
  menu             Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  section          MenuMediaSection
  mediaType        MediaType
  url              String
  caption          String?
  order            Int                   @default(0)
  processingStatus MediaProcessingStatus @default(READY)

  @@index([menuId])
  @@map("menu_media")
}

// ---------- Events (to'y buyurtmalari) ----------

model Event {
  id            String      @id @default(cuid())
  clientName    String
  clientPhone   String
  eventDate     DateTime
  tableCapacity Int
  guestCount    Int
  menuId        String
  menu          Menu        @relation(fields: [menuId], references: [id])
  totalPrice    Decimal     @db.Decimal(14, 2)
  status        EventStatus @default(PENDING)
  // The couple's pick from the menu's options — chefs plan shopping around
  // these and the guest count. Stored as names so later menu edits don't
  // rewrite what was agreed. Set by SUPER_ADMIN only.
  firstDish     String?
  secondDish    String?
  notes         String?
  createdById   String
  createdBy     StaffUser   @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignments   EventWorkerAssignment[]
  shoppingLists ShoppingList[]
  payments      Payment[]
  expenses      EventExpense[]
  stockUsages   StockUsage[]

  @@index([eventDate])
  @@map("events")
}

model EventWorkerAssignment {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   StaffUser @relation("AssignmentByStaff", fields: [assignedById], references: [id])
  roleAtEvent  String?
  createdAt    DateTime  @default(now())

  @@unique([eventId, workerId])
  @@index([eventId])
  @@index([workerId])
  @@map("event_worker_assignments")
}

// ---------- Warehouse / inventory ----------

model InventoryItem {
  id              String            @id @default(cuid())
  name            String            @unique
  category        InventoryCategory @default(PRODUCT)
  productCategory ProductCategory?
  photoUrl        String?
  unit            Unit
  quantity        Decimal           @default(0) @db.Decimal(12, 3)
  minThreshold    Decimal?          @db.Decimal(12, 3)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  transactions InventoryTransaction[]
  lots         InventoryLot[]
  usageItems   StockUsageItem[]

  @@map("inventory_items")
}

// Stock bought at one price. When the price changes on a refill a new lot is
// opened, and the oldest lot is always used up first — so what a wedding took
// from the store is costed at what that stock actually cost.
model InventoryLot {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // What is still left of this lot.
  quantity  Decimal       @db.Decimal(12, 3)
  // null until the super admin prices it (stock that predates pricing).
  unitPrice Decimal?      @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
  @@map("inventory_lots")
}

// What a chef took from the store for one wedding, in one go.
model StockUsage {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id])
  workerId         String
  worker           Worker   @relation(fields: [workerId], references: [id])
  // Telegram messages announcing it, so the bot can edit them on a return.
  telegramMessages Json?
  createdAt        DateTime @default(now())

  items StockUsageItem[]

  @@index([eventId])
  @@map("stock_usages")
}

model StockUsageItem {
  id          String        @id @default(cuid())
  usageId     String
  usage       StockUsage    @relation(fields: [usageId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  // Name and unit as they were, should the item be renamed later.
  name        String
  unit        Unit
  quantity    Decimal       @db.Decimal(12, 3)
  // null when some of the stock taken had no price yet.
  totalCost   Decimal?      @db.Decimal(14, 2)
  // [{ quantity, unitPrice }] per lot drawn from — used to put it back exactly.
  allocations Json

  @@index([usageId])
  @@map("stock_usage_items")
}

model InventoryTransaction {
  id                       String            @id @default(cuid())
  itemId                   String
  item                     InventoryItem     @relation(fields: [itemId], references: [id])
  type                     InventoryTxnType
  quantity                 Decimal           @db.Decimal(12, 3)
  note                     String?
  sourceShoppingListItemId String?           @unique
  sourceShoppingListItem   ShoppingListItem? @relation(fields: [sourceShoppingListItemId], references: [id])
  // null when a chef moved the stock (taking it for a wedding); the note says who.
  createdById              String?
  createdBy                StaffUser?        @relation(fields: [createdById], references: [id])
  createdAt                DateTime          @default(now())

  @@index([itemId])
  @@map("inventory_transactions")
}

// ---------- Shopping lists (oshpazlar bozorlik ro'yxati) ----------

model ShoppingList {
  id                String             @id @default(cuid())
  eventId           String?
  event             Event?             @relation(fields: [eventId], references: [id])
  createdByWorkerId String
  createdByWorker   Worker             @relation(fields: [createdByWorkerId], references: [id])
  status            ShoppingListStatus @default(SUBMITTED)
  reviewedById      String?
  reviewedBy        StaffUser?         @relation("ShoppingListReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  // Set when SUPER_ADMIN forwards the (possibly edited) list to ADMIN —
  // ADMIN never sees a list before this.
  approvedById      String?
  approvedBy        StaffUser?         @relation("ShoppingListApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  // Clears ADMIN's notification badge once they open the lists page.
  adminSeenAt       DateTime?
  // Telegram messages announcing this list, so the bot can edit them later.
  telegramMessages  Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items ShoppingListItem[]

  @@index([eventId])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id               String       @id @default(cuid())
  shoppingListId   String
  shoppingList     ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name             String
  quantity         Decimal      @db.Decimal(12, 3)
  // What the chef originally asked for, recorded the first time SUPER_ADMIN
  // changes the quantity. 0 means SUPER_ADMIN added the item themselves.
  originalQuantity Decimal?     @db.Decimal(12, 3)
  unit             Unit
  unitPrice        Decimal?     @db.Decimal(12, 2)
  // Exactly what was paid for the line. Kept separately because a total
  // typed at the bazaar (200 000 for 38 kg) can't round-trip through a
  // 2-decimal unit price; all sums use this.
  totalCost        Decimal?     @db.Decimal(14, 2)
  isPurchased      Boolean      @default(false)
  note             String?

  inventoryTransaction InventoryTransaction?

  @@index([shoppingListId])
  @@map("shopping_list_items")
}

// ---------- Accounting ----------

/// A refund is money handed back to the client (e.g. a deposit returned
/// when a wedding is called off). Amount stays positive; sums subtract it.
enum PaymentType {
  PAYMENT
  REFUND
}

model Payment {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        PaymentType   @default(PAYMENT)
  amount      Decimal       @db.Decimal(14, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  note        String?
  createdById String
  createdBy   StaffUser     @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([eventId])
  @@map("payments")
}

model EventExpense {
  id          String               @id @default(cuid())
  eventId     String
  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    EventExpenseCategory
  amount      Decimal              @db.Decimal(14, 2)
  note        String?
  createdById String
  createdBy   StaffUser            @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([eventId])
  @@map("event_expenses")
}

// ---------- Audit log ----------
// Deliberately NOT a foreign key to StaffUser: actorName is captured at the
// moment of the action so the log stays intact (and readable) even if that
// staff account is later deleted.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- App settings ----------

/// Single-row, app-wide branding shown on every screen (sidebar, login,
/// client presentation). Editable by SUPER_ADMIN from the Profil page.
model AppSettings {
  id              String                 @id @default("app")
  brandName       String                 @default("Shodiyora")
  logoUrl         String?
  heroMediaUrl    String?
  heroMediaKind   String?
  heroMediaStatus MediaProcessingStatus?
  updatedAt       DateTime               @updatedAt

  @@map("app_settings")
}
