generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  ZAVZAL
}

enum WorkerPosition {
  WAITER_MALE
  WAITER_FEMALE
  CHEF
  OTHER
}

enum WorkerGender {
  MALE
  FEMALE
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MenuDishCategory {
  SALAD
  FIRST_DISH
  SECOND_DISH
  FRUIT
  DESSERT
  DRINK
  OTHER
}

enum MenuMediaSection {
  HALL
  TABLE_SETUP
  KORTEJ
  PHOTOGRAPHER
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
}

enum Unit {
  KG
  LITER
  DONA
}

enum InventoryCategory {
  DISHWARE
  PRODUCT
}

enum ProductCategory {
  VEGETABLE
  FRUIT
  MEAT
  DAIRY
  GREENS
  GRAIN
  OIL
  SPICE
  DRINK
  OTHER
}

enum InventoryTxnType {
  IN
  OUT
}

enum ShoppingListStatus {
  SUBMITTED
  REVIEWED
  APPROVED
  PURCHASED
  CLOSED
}

enum EventExpenseCategory {
  SHOPPING
  CAMERAMAN
  ARTIST
  KORTEJ
  CHEF
  WAITERS
  ZAVZAL
  CARWASH
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

// ---------- Staff (admin panel users) ----------

model StaffUser {
  id                 String    @id @default(cuid())
  fullName           String
  phone              String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  role               StaffRole
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdEvents         Event[]                 @relation("EventCreatedBy")
  assignmentsMade       EventWorkerAssignment[]  @relation("AssignmentByStaff")
  approvedWorkers       Worker[]                 @relation("WorkerApprovedBy")
  inventoryTransactions InventoryTransaction[]
  reviewedShoppingLists ShoppingList[]           @relation("ShoppingListReviewedBy")
  approvedShoppingLists ShoppingList[]           @relation("ShoppingListApprovedBy")
  payments              Payment[]
  expenses              EventExpense[]

  @@map("staff_users")
}

// ---------- Workers (hall staff: waiters / chefs) ----------

model Worker {
  id            String         @id @default(cuid())
  fullName      String
  phone         String         @unique
  pinHash       String?
  mustChangePin Boolean        @default(false)
  photoUrl      String?
  position      WorkerPosition
  gender        WorkerGender?
  status        WorkerStatus   @default(PENDING)
  approvedBy   StaffUser?   @relation("WorkerApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  assignments   EventWorkerAssignment[]
  shoppingLists ShoppingList[]

  @@map("workers")
}

// ---------- Menu packages ----------

model Menu {
  id             String   @id @default(cuid())
  name           String
  pricePerPerson Decimal  @db.Decimal(12, 2)
  description    String?
  coverImageUrl  String?
  isVip          Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dishes MenuDish[]
  media  MenuMedia[]
  events Event[]

  @@map("menus")
}

model MenuDish {
  id          String            @id @default(cuid())
  menuId      String
  menu        Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category    MenuDishCategory
  name        String
  description String?
  photoUrl    String?
  order       Int               @default(0)

  @@index([menuId])
  @@map("menu_dishes")
}

model MenuMedia {
  id        String            @id @default(cuid())
  menuId    String
  menu      Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)
  section   MenuMediaSection
  mediaType MediaType
  url       String
  caption   String?
  order     Int               @default(0)

  @@index([menuId])
  @@map("menu_media")
}

// ---------- Events (to'y buyurtmalari) ----------

model Event {
  id            String      @id @default(cuid())
  clientName    String
  clientPhone   String
  eventDate     DateTime
  tableCapacity Int
  guestCount    Int
  menuId        String
  menu          Menu        @relation(fields: [menuId], references: [id])
  totalPrice    Decimal     @db.Decimal(14, 2)
  status        EventStatus @default(PENDING)
  // The couple's pick from the menu's options — chefs plan shopping around
  // these and the guest count. Stored as names so later menu edits don't
  // rewrite what was agreed. Set by SUPER_ADMIN only.
  firstDish     String?
  secondDish    String?
  notes         String?
  createdById   String
  createdBy     StaffUser   @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignments   EventWorkerAssignment[]
  shoppingLists ShoppingList[]
  payments      Payment[]
  expenses      EventExpense[]

  @@index([eventDate])
  @@map("events")
}

model EventWorkerAssignment {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workerId      String
  worker        Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedById  String
  assignedBy    StaffUser @relation("AssignmentByStaff", fields: [assignedById], references: [id])
  roleAtEvent   String?
  createdAt     DateTime  @default(now())

  @@unique([eventId, workerId])
  @@index([eventId])
  @@index([workerId])
  @@map("event_worker_assignments")
}

// ---------- Warehouse / inventory ----------

model InventoryItem {
  id              String            @id @default(cuid())
  name            String            @unique
  category        InventoryCategory @default(PRODUCT)
  productCategory ProductCategory?
  photoUrl        String?
  unit            Unit
  quantity        Decimal           @default(0) @db.Decimal(12, 3)
  minThreshold    Decimal?          @db.Decimal(12, 3)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id                     String            @id @default(cuid())
  itemId                 String
  item                   InventoryItem     @relation(fields: [itemId], references: [id])
  type                   InventoryTxnType
  quantity               Decimal           @db.Decimal(12, 3)
  note                   String?
  sourceShoppingListItemId String?         @unique
  sourceShoppingListItem ShoppingListItem? @relation(fields: [sourceShoppingListItemId], references: [id])
  createdById            String
  createdBy              StaffUser         @relation(fields: [createdById], references: [id])
  createdAt              DateTime          @default(now())

  @@index([itemId])
  @@map("inventory_transactions")
}

// ---------- Shopping lists (oshpazlar bozorlik ro'yxati) ----------

model ShoppingList {
  id             String              @id @default(cuid())
  eventId        String?
  event          Event?              @relation(fields: [eventId], references: [id])
  createdByWorkerId String
  createdByWorker   Worker           @relation(fields: [createdByWorkerId], references: [id])
  status         ShoppingListStatus  @default(SUBMITTED)
  reviewedById   String?
  reviewedBy     StaffUser?          @relation("ShoppingListReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  // Set when SUPER_ADMIN forwards the (possibly edited) list to ADMIN —
  // ADMIN never sees a list before this.
  approvedById   String?
  approvedBy     StaffUser?          @relation("ShoppingListApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  // Clears ADMIN's notification badge once they open the lists page.
  adminSeenAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items ShoppingListItem[]

  @@index([eventId])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String        @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList  @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name           String
  quantity       Decimal       @db.Decimal(12, 3)
  // What the chef originally asked for, recorded the first time SUPER_ADMIN
  // changes the quantity. 0 means SUPER_ADMIN added the item themselves.
  originalQuantity Decimal?    @db.Decimal(12, 3)
  unit           Unit
  unitPrice      Decimal?      @db.Decimal(12, 2)
  // Exactly what was paid for the line. Kept separately because a total
  // typed at the bazaar (200 000 for 38 kg) can't round-trip through a
  // 2-decimal unit price; all sums use this.
  totalCost      Decimal?      @db.Decimal(14, 2)
  isPurchased    Boolean       @default(false)
  note           String?

  inventoryTransaction InventoryTransaction?

  @@index([shoppingListId])
  @@map("shopping_list_items")
}

// ---------- Accounting ----------

/// A refund is money handed back to the client (e.g. a deposit returned
/// when a wedding is called off). Amount stays positive; sums subtract it.
enum PaymentType {
  PAYMENT
  REFUND
}

model Payment {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        PaymentType   @default(PAYMENT)
  amount      Decimal       @db.Decimal(14, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  note        String?
  createdById String
  createdBy   StaffUser     @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([eventId])
  @@map("payments")
}

model EventExpense {
  id          String               @id @default(cuid())
  eventId     String
  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    EventExpenseCategory
  amount      Decimal              @db.Decimal(14, 2)
  note        String?
  createdById String
  createdBy   StaffUser            @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([eventId])
  @@map("event_expenses")
}

// ---------- Audit log ----------
// Deliberately NOT a foreign key to StaffUser: actorName is captured at the
// moment of the action so the log stays intact (and readable) even if that
// staff account is later deleted.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- App settings ----------

/// Single-row, app-wide branding shown on every screen (sidebar, login,
/// client presentation). Editable by SUPER_ADMIN from the Profil page.
model AppSettings {
  id        String   @id @default("app")
  brandName     String   @default("Shodiyora")
  logoUrl       String?
  heroMediaUrl  String?
  heroMediaKind String?
  updatedAt     DateTime @updatedAt

  @@map("app_settings")
}
