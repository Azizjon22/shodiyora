# Server-side only: used by Server Components/Actions and the API proxy route to reach NestJS.
API_URL="http://localhost:3001/api"

# Used to encrypt the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-session-secret-change-me"

# Shown to clients on the public /menyular pages as the hall's contact number.
NEXT_PUBLIC_CONTACT_PHONE="+998 90 000 00 00"
