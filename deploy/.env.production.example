# Copy to the repository root as .env.production and fill in every value.
# Never commit the filled-in file.

# The site's address, without https:// (its DNS A record must point at this server).
DOMAIN=shodiyora.example.uz

# Generate each secret separately with:  openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# The first (and only seeded) account. The password is asked to be changed at first login.
SEED_SUPER_ADMIN_PHONE=+998900000000
SEED_SUPER_ADMIN_PASSWORD=

# Telegram bot from @BotFather. Leave empty to keep the bot off.
TELEGRAM_BOT_TOKEN=
# Reminder times, comma-separated HH:MM, Tashkent time.
TELEGRAM_REMINDER_TIMES=09:00,20:00

# Phone number shown to clients on the menu presentation pages.
CONTACT_PHONE=+998 90 000 00 00
